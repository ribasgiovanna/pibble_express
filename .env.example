# Copie para .env e ajuste os valores. O .env NÃO deve ser versionado.

# Chave secreta do Django (gere uma nova para cada ambiente)
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria

# "True" em desenvolvimento, "False" em produção
DJANGO_DEBUG=True

# Hosts permitidos, separados por vírgula (ex.: meusite.com,www.meusite.com)
DJANGO_ALLOWED_HOSTS=
